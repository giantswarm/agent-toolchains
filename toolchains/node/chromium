#!/bin/sh
# The node toolchain's Chromium, the executablePath of every launch the
# playwright-browser skill makes (bin/playwright-cli, a repository's
# `playwright test` through the skill's override configuration).
#
# A page must not reach muster's in-cluster host: the egress gateway gives
# every client in the actor the person's credential there. The rules cover
# every name of it: muster.<namespace>.svc.cluster.local, its trailing-dot
# form, and the short forms the cluster's search domains resolve (muster,
# muster.<namespace>, muster.<namespace>.svc). They come after Playwright's
# arguments, since Chromium keeps the last of a repeated switch. They hold
# while Chromium resolves names itself: not through an explicit proxy, not for
# another executable, not for a request Node sends (route.fetch(), request,
# page.request), and not for muster's address or another name resolving to it.
#
# Chromium's fonts and ICU data live under the prefix, which no Harness image
# holds at the system paths.
prefix=/opt/kagent/tools/node
export FONTCONFIG_FILE="${prefix}/etc/fonts/fonts.conf"
if [ -z "${ICU_DATA:-}" ]; then
  for dir in "${prefix}"/usr/share/icu/*/; do
    ICU_DATA="${dir%/}"
  done
  export ICU_DATA
fi
# Only a deny-all caller rule can replace the Muster-specific rules.
resolver_rules='MAP muster ^NOTFOUND, MAP muster.* ^NOTFOUND'
for argument do
  if [ "$argument" = '--host-resolver-rules=MAP * ^NOTFOUND' ]; then
    resolver_rules='MAP * ^NOTFOUND'
  fi
done
exec "${prefix}/usr/lib/chromium/chromium" "$@" \
  "--host-resolver-rules=${resolver_rules}"
